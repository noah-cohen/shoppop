# Copy this file to .env and edit it privately. Never share connection strings.
# Leave DATABASE_URL empty to keep using the existing local SQLite database.
DATABASE_URL=
# Azure uses a password-free PostgreSQL URL and managed identity.
DATABASE_AUTH=password
AZURE_TENANT_ID=
# Only for an explicitly authorized empty demo database; never enable by default.
ALLOW_DEMO_SEED=false
# Allows a demo to start without email delivery. Does not bypass authentication.
DEMO_MODE=false
# Only used when creating a new administrator, not after migrating an existing one.
ADMIN_PASSWORD=
HOST=127.0.0.1
PORT=3000
# Render sets this to true. Keep false for local HTTP.
COOKIE_SECURE=false
# Required for email sign-in. Verify the sender domain in Resend before deployment.
RESEND_API_KEY=
EMAIL_FROM=יום מכירה <login@example.com>
